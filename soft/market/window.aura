;; Rolling window on the live book. Does not call mk:reset!.
;; *tick* only moves forward inside mk:tick!.
(load "/workspace/aura-market/soft/market/book.aura")
(load "/workspace/aura-market/soft/market/book_m12.aura")
(load "/workspace/aura-market/soft/market/rules.aura")
(load "/workspace/aura-market/soft/market/hot.aura")

(define *win-w* 12)
(define *win-deltas* (list))
(define *win-prev-pnl* 0)
(define *win-prev-pen* 0)
(define *win-score* 0)
(define *win-base* #f)
(define *win-next* #f)
(define *win-body* #f)
(define *win-phase* "base")

(define (mk:window-base! n)
  (set! *win-base* n)
  n)

(define (mk:window-arm! body)
  (set! *win-next* body)
  body)

;; Swap only when the past window is strictly above the stored base.
;; The next window heals when it is not strictly above that base.
;; A strictly better trial stays and becomes the shadow and the new base.
(define (mk:window-boundary! score tick)
  (cond
    ((and (string=? *win-phase* "trial")
          (number? *win-base*)
          (<= score *win-base*))
     (mk:journal! "heal" *win-base* score)
     (hot-strategy:heal!)
     (set! *win-phase* "base")
     (mk:apply-law-params!)
     (display "HEAL name=mk:law tick=")
     (display (number->string tick))
     (display " reason=window")
     (newline)
     score)
    ((and (string=? *win-phase* "trial")
          (number? *win-base*)
          (> score *win-base*)
          (string? *win-body*))
     (mk:journal! "keep" *win-base* score)
     (mk:promote-shadow! *win-body*)
     (set! *win-base* score)
     (set! *win-phase* "base")
     (mk:apply-law-params!)
     score)
    ((and (string=? *win-phase* "base")
           (string? *win-next*)
           (number? *win-base*)
           (> score *win-base*))
     (let ((body *win-next*))
       (mk:journal! "swap" *win-base* score)
       (set! *win-base* score)
       (set! *win-phase* "trial")
       (set! *win-next* #f)
       (set! *win-body* body)
       (mk:apply-body! body "window")
       score))
    (#t
     (if (not (number? *win-base*))
         (set! *win-base* score))
     score)))

(define (mk:win-sum xs)
  (if (null? xs)
      0
      (+ (car xs) (mk:win-sum (cdr xs)))))

(define (mk:window-note!)
  (let ((d (- (- *pnl* *win-prev-pnl*) (- *penalty* *win-prev-pen*))))
    (set! *win-prev-pnl* *pnl*)
    (set! *win-prev-pen* *penalty*)
    (set! *win-deltas* (append *win-deltas* (list d)))
    (if (>= (length *win-deltas*) *win-w*)
        (let ((score (mk:win-sum *win-deltas*))
              (tick *tick*))
          (set! *win-score* score)
          (set! *win-deltas* (list))
          (display "WINDOW tick=")
          (display (number->string tick))
          (display " from=")
          (display (number->string (- tick (- *win-w* 1))))
          (display " to=")
          (display (number->string tick))
          (display " score=")
          (display (mk:nstr score))
          (newline)
          (mk:window-boundary! score tick)
          score)
        0)))
