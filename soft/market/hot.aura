;; Hot MM-strategy slot + helpers for M1/M2.
;; mk:law / mk:shadow return (spread size bias). swap! / heal! are std/hot-strategy.
;; fiber race helpers live in rules.aura; this file does not fake fiber_live.
;; M0 does not load this file.

(require "std/hot-strategy" all:)
(require "std/string" all:)

(define *tight-body* "(lambda () (list 1 3 2))")
(define *wide-body* "(lambda () (list 3 5 0))")
(define *mid-body* "(lambda () (list 2 4 0))")
(define *main-body* *wide-body*)
(define *strategy-seeded* 0)
(define *base-last* 0)
(define *trial-last* 0)
(define *propose-tag* "boot")

(define *seed-src*
  (string-append
   "(define (mk:law) (list 3 5 0))\n"
   "(define (mk:shadow) (list 3 5 0))\n"))

(define (mk:strategy-seed!)
  (if (= *strategy-seeded* 1)
      (list #t "seed")
      (let ((sc (try (set-code *seed-src*) (catch (e) e))))
        (if (not (equal? sc #t))
            (list #f "seed")
            (begin
              (eval-current)
              (hot-strategy:register! "mk:law" *wide-body*)
              (set! *main-body* *wide-body*)
              (set! *strategy-seeded* 1)
              (set! *race-backend* 0)
              (set! *race-spawned* 0)
              (set! *race-joined* 0)
              (if (and (pair? (try (mk:law) (catch (e) #f)))
                       (pair? (try (mk:shadow) (catch (e) #f))))
                  (list #t "seed")
                  (list #f "probe")))))))

(define (mk:bad-body? s)
  (or (string-contains? s "set!")
      (string-contains? s "vector-set!")
      (string-contains? s "display")
      (string-contains? s "mutate")
      (string-contains? s "eval")
      (string-contains? s "load")
      (string-contains? s "shell")
      (string-contains? s "http")
      (string-contains? s "mk:reset")
      (string-contains? s "mk:tick")
      (string-contains? s "mk:race")
      (string-contains? s "fiber:")))

(define (mk:body-ok? body)
  (and (string? body)
       (> (string-length body) 10)
       (< (string-length body) 2000)
       (string-prefix? body "(lambda")
       (not (mk:bad-body? body))))

(define (mk:probe-law!)
  (let ((v (try (mk:law) (catch (e) #f))))
    (mk:pack-ok? v)))

(define (mk:apply-law-params!)
  (let ((p (mk:law)))
    (set! *hs* (mk:pack-hs p))
    (set! *sz* (mk:pack-sz p))
    (set! *ib* (mk:pack-ib p))
    (set! *wv* (mk:pack-winv p))
    (set! *wd* (mk:pack-wdrift p))
    (set! *wi* (mk:pack-wimb p))
    p))

(define (mk:live-tick! tag)
  (mk:apply-law-params!)
  (mk:tick! tag))

;; Install a lambda string into mk:law. Does not touch mk:shadow.
;; Gate reject leaves the slot alone. A bad probe heal!s the pre-swap snap.
;; A regime KEEP leaves this swapped body in place, so (mk:law) is the pack.
(define (mk:apply-body! body reason)
  (let ((clean (if (string? body) (string-trim body) "")))
    (cond
      ((not (mk:body-ok? clean))
       (display "GATE reject reason=gate")
       (newline)
       (list #f "gate"))
      (#t
       (let ((sw (hot-strategy:swap! "mk:law" clean reason)))
         (if (not (and (pair? sw) (equal? (car sw) #t)))
             (begin
               (display "GATE reject reason=swap")
               (newline)
               (list #f "swap"))
             (if (mk:probe-law!)
                 (begin
                   (display "SWAP name=mk:law tick=")
                   (display (number->string *tick*))
                   (display " reason=")
                   (display reason)
                   (newline)
                   (list #t "swap"))
                 (begin
                   (hot-strategy:heal!)
                   (display "HEAL name=mk:law tick=")
                   (display (number->string *tick*))
                   (display " reason=probe")
                   (newline)
                   (list #f "probe")))))))))

(define (mk:sync-main!)
  (hot-strategy:swap! "mk:shadow" *main-body* "shadow")
  (hot-strategy:swap! "mk:law" *main-body* "choose")
  *main-body*)

(define (mk:pack-from-body body)
  (let ((clean (if (string? body) (string-trim body) "")))
    (if (not (mk:body-ok? clean))
        #f
        (let ((sw (hot-strategy:swap! "mk:law" clean "probe-pack")))
          (if (not (and (pair? sw) (equal? (car sw) #t)))
              #f
              (let ((p (try (mk:law) (catch (e) #f))))
                (hot-strategy:heal!)
                (if (mk:pack-ok? p) p #f)))))))
