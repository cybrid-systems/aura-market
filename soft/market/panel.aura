;; Fixed seed panel for the quant loop. First seed is the M0 tape.
;; Scores are pure mk:score-seed calls. This file does not set! the book.

(define *panel-seeds* (list 20261005 1265 9 19))

(define (mk:panel-seeds) *panel-seeds*)

(define (mk:panel-len) (length *panel-seeds*))

(define (mk:seed-thunk qf mid seed0)
  (lambda () (mk:score-seed qf mid seed0 *ticks*)))

(define (mk:seed-thunks qf mid seeds)
  (if (null? seeds)
      (list)
      (cons (mk:seed-thunk qf mid (car seeds))
            (mk:seed-thunks qf mid (cdr seeds)))))

;; One fiber per seed for a single law. No nested spawn.
(define (mk:panel-fiber! qf mid)
  (mk:race-many! (mk:seed-thunks qf mid *panel-seeds*)))
