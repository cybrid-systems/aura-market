;; --- M1/M2 pack + live tick (M0 does not call these) ---
;; Pack is (spread size bias). qf from pack:
;;   skew = bias>0 ? qdiv(inv, bias) : 0
;;   bid = fair-spread-skew / size-bias*inv
;;   ask = fair+spread-skew / size+bias*inv
;; mm-tight ≡ (1 3 2), mm-wide ≡ (3 5 0).

(define *hs* 0)
(define *sz* 0)
(define *ib* 0)
(define *wv* 0)
(define *wd* 0)
(define *wi* 0)
(define *ld0* 0)
(define *ld1* 0)
(define *ld2* 0)
(define *ld3* 0)
(define *bias-boost* 0)
(define *rng* 0)
(define *invsum* 0)
(define *live-mid* 9)

(define (mk:pack-hs p) (car p))
(define (mk:pack-sz p) (car (cdr p)))
(define (mk:pack-ib p) (car (cdr (cdr p))))

(define (mk:pack-tail p) (cdr (cdr (cdr p))))

(define (mk:pack-winv p)
  (let ((t (mk:pack-tail p)))
    (if (pair? t) (car t) 0)))

(define (mk:pack-wdrift p)
  (let ((t (mk:pack-tail p)))
    (if (and (pair? t) (pair? (cdr t)))
        (car (cdr t))
        0)))

(define (mk:pack-wimb p)
  (let ((t (mk:pack-tail p)))
    (if (and (pair? t) (pair? (cdr t)) (pair? (cdr (cdr t))))
        (car (cdr (cdr t)))
        0)))

(define (mk:int? n)
  (and (number? n) (= n (floor n))))

(define (mk:w-ok? n)
  (and (mk:int? n) (>= n -16) (<= n 16)))

(define (mk:pack-head-ok? p)
  (and (pair? p)
       (pair? (cdr p))
       (pair? (cdr (cdr p)))
       (mk:int? (mk:pack-hs p))
       (mk:int? (mk:pack-sz p))
       (mk:int? (mk:pack-ib p))
       (> (mk:pack-hs p) 0)
       (<= (mk:pack-hs p) 16)
       (> (mk:pack-sz p) 0)
       (<= (mk:pack-sz p) 32)
       (>= (mk:pack-ib p) 0)
       (<= (mk:pack-ib p) 16)))

;; Three integers, or three plus three weights in -16..16.
(define (mk:pack-ok? p)
  (and (mk:pack-head-ok? p)
       (let ((t (mk:pack-tail p)))
         (or (null? t)
             (and (pair? t)
                  (pair? (cdr t))
                  (pair? (cdr (cdr t)))
                  (null? (cdr (cdr (cdr t))))
                  (mk:w-ok? (car t))
                  (mk:w-ok? (car (cdr t)))
                  (mk:w-ok? (car (cdr (cdr t)))))))))

(define (mk:qf-weights hs sz ib winv wdrift wimb)
  (lambda (fair inv drift imb)
    (let ((skew (+ (if (> ib 0) (mk:qdiv inv ib) 0)
                   (+ (* winv inv)
                      (+ (* wdrift drift) (* wimb imb)))))
          (adj (+ (* ib inv)
                  (+ (* winv inv)
                     (+ (* wdrift drift) (* wimb imb))))))
      (list (- (- fair hs) skew)
            (- sz adj)
            (- (+ fair hs) skew)
            (+ sz adj)))))

(define (mk:qf-from hs sz ib)
  (mk:qf-weights hs sz ib 0 0 0))

(define (mk:qf-pack p)
  (mk:qf-weights (mk:pack-hs p) (mk:pack-sz p) (mk:pack-ib p)
                 (mk:pack-winv p) (mk:pack-wdrift p) (mk:pack-wimb p)))

(define (mk:score-pack p)
  (mk:r-score (mk:sim-go (mk:qf-pack p) 9 "race" 0 *seed* *ticks* 1 "calm")))

(define (mk:stamp-pack! p tag)
  (mk:stamp-go! (mk:qf-pack p) 9 tag 1))

(define (mk:live-score)
  ;; Prefer stamped pnl/penalty (set by mk:stamp!). Mid-run ticks refresh them.
  (- *pnl* *penalty*))

;; Live-book production controls. Defaults keep the M0 tape and the
;; fee-free live window unchanged. *loss-floor* stays armed across reset.
(define *live-regime* "calm")
(define *halt* 0)
(define *loss-floor* #f)
(define *fee-per-unit* 0)
(define *fee-paid* 0)
(define *gross-cash* 0)
(define *last-fill* 0)
(define *last-px* 0)
(define *last-side* 0)

;; Attempts live here, not in the AST mutation log. hot-strategy:heal!
;; restores the pre-swap snapshot, and that snapshot's log does not
;; contain the rebind. This list is workspace data, so it stays.
(define *ledger* (list))

(define (mk:ledger) *ledger*)

(define (mk:ledger-clear!)
  (set! *ledger* (list))
  0)

(define (mk:ledger-pack)
  (let ((p (try (mk:law) (catch (e) #f))))
    (if (and (pair? p) (mk:pack-ok? p))
        (list (mk:pack-hs p) (mk:pack-sz p) (mk:pack-ib p))
        (list))))

(define (mk:ledger-muts action)
  (if (string=? action "heal")
      (let ((xs (try (query:mutations-since 0) (catch (e) (list)))))
        (if (pair? xs) xs (list)))
      (list)))

;; Record the decision before heal! runs. For a heal, the pack is the
;; trial still installed, and muts still contain its rebind line.
(define (mk:ledger-note! action base trial)
  (set! *ledger*
        (append *ledger*
                (list (list action *tick* base trial
                            (mk:ledger-pack)
                            (mk:ledger-muts action)))))
  (length *ledger*))

;; ref.aura overrides mk:journal! and must call mk:ledger-note! itself.
;; Unloaded, this records and prints nothing.
(define (mk:journal! action base trial)
  (mk:ledger-note! action base trial)
  0)
(define (mk:ref-check!) 0)

(define (mk:arm-floor! n)
  (set! *loss-floor* n)
  n)

(define (mk:halt! reason)
  (set! *halt* 1)
  (set! *book* (list))
  (set! *last-fill* 0)
  (display "HALT tick=")
  (display (number->string *tick*))
  (display " reason=")
  (display reason)
  (newline)
  (mk:journal! "halt" (mk:live-score) (if (number? *loss-floor*) *loss-floor* 0))
  *tick*)

(define (mk:resume!)
  (set! *halt* 0)
  (display "RESUME tick=")
  (display (number->string *tick*))
  (newline)
  (mk:journal! "resume" (mk:live-score) 0)
  *tick*)

;; Clock continues. No quote, no fill, inventory and cash stay put.
;; Fair still marks pnl. The strategy window does not close while halted.
(define (mk:tick-halted! tag)
  (let* ((r *rng*)
         (drift (mk:t-drift r))
         (fair1 (+ *fair* drift)))
    (set! *ld0* *ld1*)
    (set! *ld1* *ld2*)
    (set! *ld2* *ld3*)
    (set! *ld3* 0)
    (set! *fair* fair1)
    (set! *book* (list))
    (set! *last-fill* 0)
    (set! *rng* (mk:seed-step r))
    (set! *tick* (+ *tick* 1))
    (set! *pnl* (+ *cash* (* *inv* *fair*)))
    (mk:ref-check!)
    *tick*))

(define (mk:reset!)
  (set! *book* (list))
  (set! *fair* *fair0*)
  (set! *inv* 0)
  (set! *cash* 0)
  (set! *fills* 0)
  (set! *rejects* 0)
  (set! *pnl* 0)
  (set! *penalty* 0)
  (set! *tick* 0)
  (set! *invsum* 0)
  (set! *bias-boost* 0)
  (set! *ld0* 0)
  (set! *ld1* 0)
  (set! *ld2* 0)
  (set! *ld3* 0)
  (set! *rng* (mk:seed-step *seed*))
  (set! *slot-tag* "live")
  (set! *live-regime* "calm")
  (set! *halt* 0)
  (set! *fee-paid* 0)
  (set! *gross-cash* 0)
  (set! *last-fill* 0)
  (set! *last-px* 0)
  (set! *last-side* 0)
  0)

;; M8 overrides this. The no-op keeps M1 from printing window lines.
(define (mk:window-note!) 0)

;; One in-play tick on the live book using *hs*/*sz*/*ib* (+ bias-boost).
;; Does not retcon prior ticks. MUTATE at tick 8 raises *bias-boost*.
;; A halted slot consumes the clock and marks fair, and does not quote.
(define (mk:tick! tag)
  (if (= *halt* 1)
      (begin
        (set! *slot-tag* tag)
        (mk:tick-halted! tag))
      (mk:tick-open! tag)))

(define (mk:tick-open! tag)
  (set! *slot-tag* tag)
  (let* ((r *rng*)
         (flow (mk:flow r *live-regime*))
         (drift (mk:flow-drift flow))
         (imb (+ *ld0* (+ *ld1* (+ *ld2* *ld3*))))
         (fair1 (+ *fair* drift))
         (ib (+ *ib* *bias-boost*))
         (qf (mk:qf-weights *hs* *sz* ib *wv* *wd* *wi*))
         (q (qf fair1 *inv* drift imb))
         (bid (mk:order 0 (car q) (car (cdr q)) *live-mid*))
         (ask (mk:order 1 (car (cdr (cdr q))) (car (cdr (cdr (cdr q)))) *live-mid*))
         (gb (mk:gate bid ask *inv* fair1))
         (ga (mk:gate ask bid *inv* fair1))
         (nrej (+ (if (string=? gb "ok") 0 1)
                  (if (string=? ga "ok") 0 1)))
         (bk (append (if (string=? gb "ok") (list bid) (list))
                     (if (string=? ga "ok") (list ask) (list))))
         (side (mk:flow-side flow))
         (tq (mk:flow-qty flow))
         (aggr (mk:flow-aggr flow))
         (hit (if (= side 0) (mk:side-of bk 1) (mk:side-of bk 0)))
         (crosses (and hit
                       (if (= side 0)
                           (<= (mk:o-px hit) (+ fair1 aggr))
                           (>= (mk:o-px hit) (- fair1 aggr)))))
         (f (if crosses (mk:min tq (mk:o-qty hit)) 0))
         (px (if crosses (mk:o-px hit) 0))
         (inv1 (if (= side 0) (- *inv* f) (+ *inv* f)))
         (gross-delta (if (= side 0) (* f px) (- 0 (* f px))))
         (fee (* f *fee-per-unit*))
         (cash1 (- (+ *cash* gross-delta) fee))
         (rest (if (and crosses (> (- (mk:o-qty hit) f) 0))
                   (if (= side 0)
                       (append (if (mk:side-of bk 0) (list (mk:side-of bk 0)) (list))
                               (list (mk:order 1 px (- (mk:o-qty hit) f) *live-mid*)))
                       (append (list (mk:order 0 px (- (mk:o-qty hit) f) *live-mid*))
                               (if (mk:side-of bk 1) (list (mk:side-of bk 1)) (list))))
                   (if crosses
                       (if (= side 0)
                           (if (mk:side-of bk 0) (list (mk:side-of bk 0)) (list))
                           (if (mk:side-of bk 1) (list (mk:side-of bk 1)) (list)))
                       bk))))
    (set! *ld0* *ld1*)
    (set! *ld1* *ld2*)
    (set! *ld2* *ld3*)
    (set! *ld3* (- inv1 *inv*))
    (set! *fair* fair1)
    (set! *inv* inv1)
    (set! *gross-cash* (+ *gross-cash* gross-delta))
    (set! *fee-paid* (+ *fee-paid* fee))
    (set! *cash* cash1)
    (set! *last-fill* f)
    (set! *last-px* px)
    (set! *last-side* side)
    (set! *book* rest)
    (set! *invsum* (+ *invsum* (mk:abs inv1)))
    (set! *fills* (+ *fills* (if crosses 1 0)))
    (set! *rejects* (+ *rejects* nrej))
    (set! *rng* (mk:seed-step r))
    (set! *tick* (+ *tick* 1))
    (set! *pnl* (+ *cash* (* *inv* *fair*)))
    (set! *penalty* (+ (quotient *invsum* 4) (* 2 (mk:abs *inv*))))
    (if (= *tick* 8)
        (begin
          (set! *bias-boost* 1)
          (display "MUTATE tick=8 bias-boost=1 slot=")
          (display tag)
          (newline)))
    (mk:ref-check!)
    (mk:window-note!)
    *tick*))
