;; M3 score probe. Grows as the milestone lands. MARKET_M3_OK is M3-6.
(load "/workspace/aura-market/soft/market/book.aura")
(load "/workspace/aura-market/soft/market/book_m12.aura")
(load "/workspace/aura-market/soft/market/rules.aura")
(load "/workspace/aura-market/soft/market/panel.aura")
(load "/workspace/aura-market/soft/market/propose.aura")

(define *fail* 0)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (mk:nstr got))
  (if (= got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (mk:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-str tag got want)
  (display tag)
  (display "=")
  (display got)
  (if (string=? got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

;; M3-1. Default path and per-seed path agree. Main slots stay at boot.
(expect "SCORE_TIGHT" (mk:score quote-tight 1) -5)
(expect "SCORE_WIDE" (mk:score quote-wide 2) 18)
(expect "SEED_TIGHT" (mk:score-seed quote-tight 1 *seed* *ticks*) -5)
(expect "SEED_WIDE" (mk:score-seed quote-wide 2 *seed* *ticks*) 18)
(expect "BOOK" (length *book*) 0)
(expect "FAIR" *fair* 0)
(expect "INV" *inv* 0)
(expect "CASH" *cash* 0)
(expect "TICK" *tick* 0)
(expect "PNL" *pnl* 0)
(expect "PENALTY" *penalty* 0)

(if (= *fail* 0)
    (display "M3_1_OK\n")
    (display "M3_1_FAIL\n"))

;; M3-2. Four fixed seeds. First is the M0 seed. Print both quoters.
(expect "PANEL_N" (mk:panel-len) 4)
(expect "PANEL_0" (car (mk:panel-seeds)) 20261005)

(define (show-seed name qf mid seed0 want)
  (let ((got (mk:score-seed qf mid seed0 *ticks*)))
    (display "SEEDSCORE ")
    (display name)
    (display " seed=")
    (display (number->string seed0))
    (display " score=")
    (display (mk:nstr got))
    (newline)
    (expect name got want)))

(show-seed "WIDE_0" quote-wide 2 20261005 18)
(show-seed "WIDE_1" quote-wide 2 1265 73)
(show-seed "WIDE_2" quote-wide 2 9 83)
(show-seed "WIDE_3" quote-wide 2 19 39)
(show-seed "TIGHT_0" quote-tight 1 20261005 -5)
(show-seed "TIGHT_1" quote-tight 1 1265 -2)
(show-seed "TIGHT_2" quote-tight 1 9 22)
(show-seed "TIGHT_3" quote-tight 1 19 8)
(expect "BOOK_AFTER" (length *book*) 0)

(if (= *fail* 0)
    (display "M3_2_OK\n")
    (display "M3_2_FAIL\n"))

;; M3-3. A partial join is not fiber_live. A full panel may be.
(set! *race-backend* 2)
(set! *race-spawned* 4)
(set! *race-joined* 3)
(expect-str "PARTIAL" (mk:finish-world!) "host-sequential")
(set! *race-backend* 0)
(set! *race-spawned* 0)
(set! *race-joined* 0)
(set! *world-line* "host-sequential")
(define panel-wide (mk:panel-fiber! quote-wide 2))
(expect "FIBER_0" (car panel-wide) 18)
(expect "FIBER_1" (car (cdr panel-wide)) 73)
(expect "FIBER_2" (car (cdr (cdr panel-wide))) 83)
(expect "FIBER_3" (car (cdr (cdr (cdr panel-wide)))) 39)
(mk:stamp-world!)
(if (string=? *world-line* "fiber_live")
    (if (not (and (> *race-backend* 0)
                  (= *race-joined* *race-spawned*)
                  (= *race-spawned* 4)))
        (begin
          (display "WORLD_FAIL")
          (newline)
          (set! *fail* (+ *fail* 1))))
    (if (not (string=? *world-line* "host-sequential"))
        (begin
          (display "WORLD_FAIL")
          (newline)
          (set! *fail* (+ *fail* 1)))))
(expect "BOOK_FIBER" (length *book*) 0)

(if (= *fail* 0)
    (display "M3_3_OK\n")
    (display "M3_3_FAIL\n"))

;; M3-4. Minimum is the KEEP score. Median is recorded only.
(define wide-agg (mk:panel-report! quote-wide 2 "mm-wide"))
(define tight-agg (mk:panel-report! quote-tight 1 "mm-tight"))
(expect "WIDE_MIN" (car wide-agg) 18)
(expect "WIDE_MED" (car (cdr wide-agg)) 56)
(expect "TIGHT_MIN" (car tight-agg) -5)
(expect "TIGHT_MED" (car (cdr tight-agg)) 3)
(expect "MEDIAN_NEG" (mk:median (list -5 -2 8 22)) 3)
(expect "BOOK_AGG" (length *book*) 0)

(if (= *fail* 0)
    (display "M3_4_OK\n")
    (display "M3_4_FAIL\n"))

;; M3-5. Wins seed 20261005, loses the panel minimum, so DROP and heal.
(define (tag? r want)
  (and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) want)))

(define seeded (mk:strategy-seed!))
(if (not (and (pair? seeded) (equal? (car seeded) #t)))
    (begin
      (display "SEED_FAIL")
      (newline)
      (set! *fail* (+ *fail* 1))))
(define spec-one (mk:score-pack (list 2 2 2)))
(expect "SPEC_SEED" spec-one 50)
(define spec (mk:propose-file!
              "/workspace/aura-market/soft/market/fixtures/specialist.lambda"))
(if (not (tag? spec "propose_drop"))
    (begin
      (display "SPEC_DROP_FAIL")
      (newline)
      (set! *fail* (+ *fail* 1))))
(expect "SPEC_BASE" *base-last* 18)
(expect "SPEC_TRIAL" *trial-last* -4)
(if (> spec-one *base-last*)
    0
    (begin
      (display "SPEC_SEED_WIN_FAIL")
      (newline)
      (set! *fail* (+ *fail* 1))))
(if (not (equal? (mk:law) (list 3 5 0)))
    (begin
      (display "SPEC_HEAL_FAIL")
      (newline)
      (set! *fail* (+ *fail* 1))))

(if (= *fail* 0)
    (display "M3_5_OK\n")
    (display "M3_5_FAIL\n"))

(if (= *fail* 0)
    (display "MARKET_M3_OK\n")
    (display "MARKET_M3_FAIL\n"))
