;; Propose → gate → race vs current main → KEEP or DROP/heal.
;; Host writes a (lambda () (list spread size bias)) file. Soft does not speak HTTP.
;; mk:shadow is the current main pack. mk:law is the trial.
;; KEEP only when the trial score is strictly greater. A tie DROPs.

(load "/workspace/aura-market/soft/market/hot.aura")
(load "/workspace/aura-market/soft/market/panel.aura")
(load "/workspace/aura-market/soft/market/regimes.aura")
(load "/workspace/aura-market/soft/market/search.aura")

;; Panel minimum, sequential inside a race thunk so fibers stay one layer.
(define (mk:pack-min p)
  (mk:list-min (mk:panel-seq-feat (mk:qf-pack p) 9)))

(define (mk:propose-score! clean)
  ;; Trial audit on the M0 tape. print=1 shows the first gate reasons.
  ;; A fat-px reject is not in the book. This does not set! the main book.
  (mk:sim-go (mk:qf-pack (mk:law)) 9 "trial" 1 *seed* *ticks* 1 "calm")
  (let ((pair (mk:race-thunks!
               (lambda () (mk:pack-min (mk:shadow)))
               (lambda () (mk:pack-min (mk:law))))))
    (let ((base (car pair))
          (trial (car (cdr pair))))
      (set! *base-last* base)
      (set! *trial-last* trial)
      (display "RACE base=")
      (display (mk:nstr base))
      (display " trial=")
      (display (mk:nstr trial))
      (display " min=")
      (display (mk:nstr base))
      (display "/")
      (display (mk:nstr trial))
      (newline)
      (if (> trial base)
          (begin
            (set! *main-body* clean)
            (set! *main-score* trial)
            (set! *main-name* "mk:law")
            (set! *keep-reason* "higher-score-stamp")
            (set! *propose-tag* "propose_keep")
            (display "KEEP reason=higher-score-stamp")
            (newline)
            (display "PROPOSE tag=propose_keep")
            (newline)
            (mk:journal! "keep" base trial)
            (mk:stamp-pack! (mk:law) "mk:law")
            (list #t "propose_keep"))
          (begin
            (hot-strategy:heal!)
            (set! *drop-reason* "lower-score-rollback")
            (set! *propose-tag* "propose_drop")
            (display "HEAL name=mk:law reason=score")
            (newline)
            (display "DROP reason=lower-score-rollback")
            (newline)
            (display "PROPOSE tag=propose_drop")
            (newline)
            (mk:journal! "drop" base trial)
            (list #f "propose_drop"))))))

;; Regime KEEP only when every mechanism is strictly higher.
;; The recorded score is min(calm, drift, aggr). A tie DROPs and heals.
;; This does not replace the panel-minimum propose path.
(define (mk:propose-regime! clean)
  (let ((xs (mk:regime-race! (mk:shadow) (mk:law))))
    (let ((b0 (mk:regime-at xs 0))
          (b1 (mk:regime-at xs 1))
          (b2 (mk:regime-at xs 2))
          (t0 (mk:regime-at xs 3))
          (t1 (mk:regime-at xs 4))
          (t2 (mk:regime-at xs 5)))
      (let ((base (mk:list-min (list b0 b1 b2)))
            (trial (mk:list-min (list t0 t1 t2))))
        (set! *base-last* base)
        (set! *trial-last* trial)
        (display "RACE base=")
        (display (mk:nstr base))
        (display " trial=")
        (display (mk:nstr trial))
        (display " min=")
        (display (mk:nstr base))
        (display "/")
        (display (mk:nstr trial))
        (newline)
        (if (and (> t0 b0) (> t1 b1) (> t2 b2))
            (begin
              (set! *main-body* clean)
              (set! *main-score* trial)
              (set! *main-name* "mk:law")
              (set! *keep-reason* "higher-score-stamp")
              (set! *propose-tag* "propose_keep")
              (display "KEEP reason=higher-score-stamp")
              (newline)
              (display "PROPOSE tag=propose_keep")
              (newline)
              (mk:journal! "keep" base trial)
              (mk:stamp-pack! (mk:law) "mk:law")
              (list #t "propose_keep"))
            (begin
              (hot-strategy:heal!)
              (set! *drop-reason* "lower-score-rollback")
              (set! *propose-tag* "propose_drop")
              (display "HEAL name=mk:law reason=score")
              (newline)
              (display "DROP reason=lower-score-rollback")
              (newline)
              (display "PROPOSE tag=propose_drop")
              (newline)
              (mk:journal! "drop" base trial)
              (list #f "propose_drop")))))))

(define (mk:propose-regime-body! body)
  (let ((clean (if (string? body) (string-trim body) "")))
    (let ((r (mk:apply-body! clean "propose")))
      (cond
        ((and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) "swap"))
         (mk:propose-regime! clean))
        ((and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) "probe"))
         (set! *propose-tag* "propose_heal")
         (display "PROPOSE tag=propose_heal")
         (newline)
         (list #f "propose_heal"))
        (#t
         (set! *propose-tag* "propose_reject")
         (display "PROPOSE tag=propose_reject")
         (newline)
         (list #f "propose_reject"))))))

;; Search KEEP only when the best pack's panel minimum is strictly higher.
;; A tie DROPs and heals. heal! does not zero *tick*. No MiniMax.
(define (mk:search-judge! best)
  (let ((clean (mk:pack-body best)))
    (let ((sw (mk:apply-body! clean "propose")))
      (if (not (and (pair? sw) (pair? (cdr sw)) (equal? (car (cdr sw)) "swap")))
          sw
          (let ((base (mk:fitness (mk:shadow)))
                (trial (mk:fitness (mk:law))))
            (set! *base-last* base)
            (set! *trial-last* trial)
            (display "RACE base=")
            (display (mk:nstr base))
            (display " trial=")
            (display (mk:nstr trial))
            (display " min=")
            (display (mk:nstr base))
            (display "/")
            (display (mk:nstr trial))
            (newline)
            (if (> trial base)
                (begin
                  (set! *main-body* clean)
                  (set! *main-score* trial)
                  (set! *main-name* "mk:law")
                  (set! *keep-reason* "higher-score-stamp")
                  (set! *propose-tag* "propose_keep")
                  (display "KEEP reason=higher-score-stamp")
                  (newline)
                  (display "PROPOSE tag=propose_keep")
                  (newline)
                  (mk:journal! "keep" base trial)
                  (mk:stamp-pack! (mk:law) "mk:law")
                  (list #t "propose_keep"))
                (begin
                  (hot-strategy:heal!)
                  (set! *drop-reason* "lower-score-rollback")
                  (set! *propose-tag* "propose_drop")
                  (display "HEAL name=mk:law reason=score")
                  (newline)
                  (display "DROP reason=lower-score-rollback")
                  (newline)
                  (display "PROPOSE tag=propose_drop")
                  (newline)
                  (mk:journal! "drop" base trial)
                  (list #f "propose_drop"))))))))

(define (mk:propose-body! body)
  (let ((clean (if (string? body) (string-trim body) "")))
    (let ((r (mk:apply-body! clean "propose")))
      (cond
        ((and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) "swap"))
         (mk:propose-score! clean))
        ((and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) "probe"))
         (set! *propose-tag* "propose_heal")
         (display "PROPOSE tag=propose_heal")
         (newline)
         (list #f "propose_heal"))
        (#t
         (set! *propose-tag* "propose_reject")
         (display "PROPOSE tag=propose_reject")
         (newline)
         (list #f "propose_reject"))))))

(define (mk:propose-file! path)
  (mk:sync-main!)
  (let ((body (try (read-file path) (catch (e) #f))))
    (if (not (string? body))
        (begin
          (display "GATE reject reason=read")
          (newline)
          (set! *propose-tag* "propose_reject")
          (display "PROPOSE tag=propose_reject")
          (newline)
          (list #f "propose_reject"))
        (mk:propose-body! body))))
