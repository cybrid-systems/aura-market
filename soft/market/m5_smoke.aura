;; M5 grid search. No MiniMax. Ends with MARKET_M5_OK.
(load "/workspace/aura-market/soft/market/propose.aura")

(define *fail* 0)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (mk:nstr got))
  (if (= got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (mk:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-eq tag got want)
  (display tag)
  (display "=")
  (display got)
  (if (equal? got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display want)
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(expect "M0_TIGHT" (mk:score quote-tight 1) -5)
(expect "M0_WIDE" (mk:score quote-wide 2) 18)
(expect "M3_WIDE" (mk:fitness (list 3 5 0)) 18)
(define book0 *book*)
(define tick0 *tick*)
(if (not (and (equal? *book* book0) (= *tick* tick0)))
    (begin (display "BOOK_TOUCH_FAIL\n") (set! *fail* (+ *fail* 1))))

(define win1 (mk:search-step!))
(expect-eq "WIN1" win1 (list 3 3 0 0 0 0))
(expect "EVALS1" *search-evals* 16)
(define win2 (mk:search-step!))
(expect-eq "WIN2" win2 win1)

(mk:strategy-seed!)
(define before (mk:law))
(set! *tick* 10)
(define bad (mk:search-judge! (mk:search-step-bad!)))
(if (not (and (pair? bad) (equal? (car (cdr bad)) "propose_drop")))
    (begin (display "BAD_DROP_FAIL\n") (set! *fail* (+ *fail* 1))))
(expect-eq "BAD_LAW" (mk:law) before)
(expect "BAD_TICK" *tick* 10)

(mk:search-parallel! #t)
(expect "PAR_SEQ" (mk:fitness (list 3 5 0)) 18)
(mk:search-mode! "fiber")
(mk:search-parallel! #f)
(mk:search-mode! "fiber")
(expect "PAR_FIBER" (mk:fitness (list 3 5 0)) 18)

(if (= *fail* 0)
    (display "MARKET_M5_OK\n")
    (display "MARKET_M5_FAIL\n"))
