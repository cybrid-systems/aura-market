;; Integer-pack fitness and a quantized grid. Pure fitness: no swap.
;; std/swarm stays in aura-grok. Floats are clamped before they reach the book.
(require "std/swarm" all:)
(load "/workspace/aura-market/soft/market/book.aura")
(load "/workspace/aura-market/soft/market/book_m12.aura")
(load "/workspace/aura-market/soft/market/rules.aura")
(load "/workspace/aura-market/soft/market/panel.aura")

;; panel=seq inside a parallel swarm. panel=fiber only when that swarm
;; is not spawning, so the panel is the single fiber layer.
(define *panel-mode* "seq")
(define *search-parallel* #f)

(define (mk:search-parallel! flag)
  (set! *search-parallel* (if flag #t #f))
  (swarm:parallel! *search-parallel*)
  (if *search-parallel*
      (set! *panel-mode* "seq"))
  (display "panel=")
  (display *panel-mode*)
  (newline)
  *panel-mode*)

(define (mk:search-mode! mode)
  (if (and (string=? mode "fiber") *search-parallel*)
      (begin
        (display "panel=seq\n")
        (display "NESTED_SPAWN_FAIL\n")
        (set! *panel-mode* "seq")
        "seq")
      (begin
        (set! *panel-mode* mode)
        (display "panel=")
        (display mode)
        (newline)
        mode)))

(define (mk:fitness-fiber p)
  (set! *race-backend* 0)
  (set! *race-spawned* 0)
  (set! *race-joined* 0)
  (set! *world-line* "host-sequential")
  (let ((qf (mk:qf-pack p)))
    (let ((xs (mk:race-many!
               (list (lambda () (mk:r-score (mk:sim-go qf 9 "race" 0 20261005 *ticks* 1 "calm")))
                     (lambda () (mk:r-score (mk:sim-go qf 9 "race" 0 1265 *ticks* 1 "calm")))
                     (lambda () (mk:r-score (mk:sim-go qf 9 "race" 0 9 *ticks* 1 "calm")))
                     (lambda () (mk:r-score (mk:sim-go qf 9 "race" 0 19 *ticks* 1 "calm")))))))
      (mk:finish-world!)
      (mk:stamp-world!)
      (mk:list-min xs))))

(define (mk:fitness p)
  (cond
    ((and (string=? *panel-mode* "fiber") *search-parallel*)
     (display "NESTED_SPAWN_FAIL\n")
     -1000000000)
    ((string=? *panel-mode* "fiber")
     (mk:fitness-fiber p))
    (#t
     (mk:list-min (mk:panel-seq-feat (mk:qf-pack p) 9)))))

(define (mk:nearest x)
  (floor (+ x 0.5)))

(define (mk:clamp n lo hi)
  (if (< n lo) lo (if (> n hi) hi n)))

;; floor can leave an inexact. quotient forces an integer.
(define (mk:as-int n)
  (quotient (floor n) 1))

;; Spread 1..6, size 1..8, weight -4..4. Bias stays 0.
;; Out-of-range points are clamped, not dropped.
(define (mk:pack-from-ind ind)
  (list (mk:as-int (mk:clamp (mk:nearest (car ind)) 1 6))
        (mk:as-int (mk:clamp (mk:nearest (car (cdr ind))) 1 8))
        0
        0
        (mk:as-int (mk:clamp (mk:nearest (car (cdr (cdr ind)))) -4 4))
        0))

(define (mk:map-packs inds)
  (if (null? inds)
      (list)
      (cons (mk:pack-from-ind (car inds))
            (mk:map-packs (cdr inds)))))

(define (mk:search-init!)
  (set! *search-parallel* #f)
  (set! *panel-mode* "seq")
  (swarm:init (hash "kind" "grid"
                    "dim" 3
                    "pop" 16
                    "bins" 3
                    "parallel" #f
                    "bounds" (list (list 1.0 5.0)
                                   (list 1.0 5.0)
                                   (list -4.0 4.0)))))

(define (mk:search-packs)
  (mk:map-packs (swarm:population)))

(define *search-evals* 0)
(define *search-budget* 16)

;; Budget lives outside mk:fitness, so the fitness function stays pure.
(define (mk:search-budget!)
  (let ((raw (getenv "MARKET_SWARM_EVALS")))
    (if (and (string? raw) (> (string-length raw) 0))
        (let ((n (string->number raw)))
          (if (and (number? n) (> n 0))
              (set! *search-budget* (quotient (floor n) 1))
              (set! *search-budget* 16)))
        (set! *search-budget* 16))
    *search-budget*))

(define (mk:search-init-bad!)
  (swarm:init (hash "kind" "grid"
                    "dim" 3
                    "pop" 4
                    "bins" 1
                    "parallel" #f
                    "bounds" (list (list 2.0 2.0)
                                   (list 2.0 2.0)
                                   (list 3.0 3.0)))))

(define (mk:pack-body p)
  (string-append "(lambda () (list "
                 (mk:nstr (car p)) " "
                 (mk:nstr (car (cdr p))) " "
                 (mk:nstr (car (cdr (cdr p)))) " "
                 (mk:nstr (car (cdr (cdr (cdr p))))) " "
                 (mk:nstr (car (cdr (cdr (cdr (cdr p)))))) " "
                 (mk:nstr (car (cdr (cdr (cdr (cdr (cdr p)))))))
                 "))"))

(define (mk:search-run! boot)
  (set! *search-evals* 0)
  (mk:search-budget!)
  (boot)
  (swarm:step!
   (lambda (ind)
     (if (>= *search-evals* *search-budget*)
         #f
         (begin
           (set! *search-evals* (+ *search-evals* 1))
           (mk:fitness (mk:pack-from-ind ind))))))
  (mk:pack-from-ind (swarm:best)))

(define (mk:search-step!)
  (mk:search-run! mk:search-init!))

(define (mk:search-step-bad!)
  (mk:search-run! mk:search-init-bad!))
