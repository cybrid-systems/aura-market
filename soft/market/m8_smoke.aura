;; M8 rolling window. Fixture packs only. No search. Ends with MARKET_M8_OK.
(load "/workspace/aura-market/soft/market/window.aura")

(define *fail* 0)

(define (expect tag got want)
  (let ((gs (if (number? got) (mk:nstr got) got))
        (ws (if (number? want) (mk:nstr want) want)))
    (display tag)
    (display "=")
    (display gs)
    (if (equal? got want)
        (display " OK")
        (begin
          (display " WANT=")
          (display ws)
          (set! *fail* (+ *fail* 1))))
    (newline)
    got))

(define (expect-pack tag p hs sz ib wv wd wi)
  (display tag)
  (display "=")
  (display p)
  (if (and (mk:pack-ok? p)
           (= (mk:pack-hs p) hs)
           (= (mk:pack-sz p) sz)
           (= (mk:pack-ib p) ib)
           (= (mk:pack-winv p) wv)
           (= (mk:pack-wdrift p) wd)
           (= (mk:pack-wimb p) wi))
      (display " OK")
      (begin
        (display " WANT=")
        (display (list hs sz ib wv wd wi))
        (set! *fail* (+ *fail* 1))))
  (newline)
  p)

(define (run n)
  (let loop ((i 0))
    (if (< i n)
        (begin
          (mk:live-tick! "mk:law")
          (loop (+ i 1))))))

(define (clear-win!)
  (set! *win-deltas* (list))
  (set! *win-prev-pnl* 0)
  (set! *win-prev-pen* 0)
  (set! *win-phase* "base")
  (set! *win-next* #f)
  (set! *win-base* #f)
  (set! *win-body* #f)
  (set! *win-score* 0))

;; six_keep then fat_side. One live book, tick only increases.
(mk:strategy-seed!)
(mk:reset!)
(clear-win!)
(mk:apply-law-params!)
(mk:window-base! 100)
(mk:window-arm! "(lambda () (list 3 3 0 0 0 0))")
(run 24)
(expect-pack "HOLD_LAW" (mk:law) 3 5 0 0 0 0)
(expect "HOLD_TICK" *tick* 24)

(mk:window-base! 0)
(run 24)
(expect-pack "KEEP_LAW" (mk:law) 3 3 0 0 0 0)
(expect-pack "KEEP_SHADOW" (mk:shadow) 3 3 0 0 0 0)
(expect "KEEP_BASE" *win-base* 10)
(expect "KEEP_SCORE" *win-score* 10)
(expect "KEEP_TICK" *tick* 48)

(mk:window-base! -100)
(mk:window-arm! "(lambda () (list 4 6 1 0 -1 0))")
(run 24)
(expect-pack "HEAL_LAW" (mk:law) 3 3 0 0 0 0)
(expect-pack "HEAL_SHADOW" (mk:shadow) 3 3 0 0 0 0)
(expect "HEAL_SCORE" *win-score* 0)
(expect "HEAL_PHASE" *win-phase* "base")
(expect "END_TICK" *tick* 72)

(if (= *fail* 0)
    (display "MARKET_M8_OK\n")
    (display "MARKET_M8_FAIL\n"))
