;; Two market-making strategies on one seeded taker flow.
;; mm-tight (mid 1): half-spread 1, size 3∓2·inv, inventory skew, size shrinks
;;   toward zero (and past it) as inventory builds.
;; mm-wide  (mid 2): half-spread 3, size 5, no skew, keeps quoting size
;;   into the inventory limit.
;; Every quote passes the Soft gate in book.aura. Rejected quotes never rest.
;; The higher score is stamped into the main book. The other is dropped.
;; fiber_live only when both fiber joins return a numeric score.
;; Otherwise the same thunks run host-sequential. Never a fake fiber_live.

(define *score-tight* 0)
(define *score-wide* 0)
(define *rej-tight* 0)
(define *rej-wide* 0)
(define *keep-mid* 0)
(define *drop-mid* 0)
(define *keep-reason* "boot")
(define *drop-reason* "boot")
(define *main-name* "none")
(define *main-mid* 0)
(define *main-score* 0)
(define *world-line* "host-sequential")
(define *race-backend* 0)
(define *race-spawned* 0)
(define *race-joined* 0)

;; mid 1. Quote (bid-px bid-qty ask-px ask-qty).
(define (quote-tight fair inv)
  (let ((skew (mk:qdiv inv 2)))
    (list (- (- fair 1) skew)
          (- 3 (* 2 inv))
          (- (+ fair 1) skew)
          (+ 3 (* 2 inv)))))

;; mid 2.
(define (quote-wide fair inv)
  (list (- fair 3) 5 (+ fair 3) 5))

(define (mm-tight) (mk:score quote-tight 1))
(define (mm-wide) (mk:score quote-wide 2))

(define (mk:race-thunks! thunk-a thunk-b)
  (set! *race-spawned* (+ *race-spawned* 2))
  (let ((b (try (fiber:spawn-backend) (catch (e) 0))))
    (if (and (number? b) (> b 0))
        (set! *race-backend* b))
    (let* ((f1 (try (fiber:spawn thunk-a) (catch (e) #f)))
           (f2 (try (fiber:spawn thunk-b) (catch (e) #f)))
           (r1 (if (and (number? f1) (> f1 0))
                   (try (fiber:join f1) (catch (e) #f))
                   #f))
           (r2 (if (and (number? f2) (> f2 0))
                   (try (fiber:join f2) (catch (e) #f))
                   #f)))
      (if (and (number? f1) (number? f2)
               (> f1 0) (> f2 0)
               (not (= f1 f2))
               (number? r1) (number? r2))
          (begin
            (set! *race-joined* (+ *race-joined* 2))
            (list r1 r2))
          (list (thunk-a) (thunk-b))))))

(define (mk:finish-world!)
  (if (and (> *race-spawned* 0)
           (= *race-joined* *race-spawned*)
           (> *race-backend* 0))
      (set! *world-line* "fiber_live")
      (set! *world-line* "host-sequential"))
  *world-line*)

(define (mk:stamp-world!)
  (mk:finish-world!)
  (display "WORLD line=")
  (display *world-line*)
  (display " backend=")
  (display (number->string *race-backend*))
  (display " joins=")
  (display (number->string *race-joined*))
  (display "/")
  (display (number->string *race-spawned*))
  (newline)
  *world-line*)

;; Strictly higher score wins. A tie keeps tight (mid 1).
(define (mk:decide! tight wide)
  (set! *score-tight* tight)
  (set! *score-wide* wide)
  (cond
    ((> wide tight)
     (set! *keep-mid* 2)
     (set! *drop-mid* 1)
     (set! *main-mid* 2)
     (set! *main-name* "mm-wide")
     (set! *keep-reason* "higher-score-stamp")
     (set! *drop-reason* "lower-score-rollback")
     (set! *main-score* (mk:stamp! quote-wide 2 "mm-wide")))
    ((> tight wide)
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "mm-tight")
     (set! *keep-reason* "higher-score-stamp")
     (set! *drop-reason* "lower-score-rollback")
     (set! *main-score* (mk:stamp! quote-tight 1 "mm-tight")))
    (#t
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "mm-tight")
     (set! *keep-reason* "tie-keep-tight-stamp")
     (set! *drop-reason* "tie-drop-wide-rollback")
     (set! *main-score* (mk:stamp! quote-tight 1 "mm-tight"))))
  *main-mid*)

(define (mk:race!)
  (set! *race-backend* 0)
  (set! *race-spawned* 0)
  (set! *race-joined* 0)
  (set! *world-line* "host-sequential")
  (let ((pair (mk:race-thunks!
               (lambda () (mm-tight))
               (lambda () (mm-wide)))))
    (mk:finish-world!)
    (display "RACE tight=")
    (display (mk:nstr (car pair)))
    (display " wide=")
    (display (mk:nstr (car (cdr pair))))
    (newline)
    ;; Host audit pass: gate rejections for both lines. Writes nothing.
    (set! *rej-tight* (mk:r-rejects (mk:audit-run quote-tight 1 "mm-tight")))
    (set! *rej-wide* (mk:r-rejects (mk:audit-run quote-wide 2 "mm-wide")))
    (display "REJECTS mid=1 total=")
    (display (number->string *rej-tight*))
    (display " mid=2 total=")
    (display (number->string *rej-wide*))
    (newline)
    (mk:decide! (car pair) (car (cdr pair))))
  *main-mid*)

(define (mk:audit!)
  (mk:stamp-world!)
  (display "MAIN slot=")
  (display *main-name*)
  (display " mid=")
  (display (number->string *main-mid*))
  (display " score=")
  (display (mk:nstr *main-score*))
  (display " pnl=")
  (display (mk:nstr *pnl*))
  (display " penalty=")
  (display (mk:nstr *penalty*))
  (display " inv=")
  (display (mk:nstr *inv*))
  (display " cash=")
  (display (mk:nstr *cash*))
  (display " fair=")
  (display (number->string *fair*))
  (display " fills=")
  (display (number->string *fills*))
  (display " rejects=")
  (display (number->string *rejects*))
  (display " book=")
  (display (number->string (length *book*)))
  (newline)
  (display "KEEP mid=")
  (display (number->string *keep-mid*))
  (display " reason=")
  (display *keep-reason*)
  (newline)
  (display "DROP mid=")
  (display (number->string *drop-mid*))
  (display " reason=")
  (display *drop-reason*)
  (newline)
  0)
