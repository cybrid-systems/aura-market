;; Production reference on the live book.
;; Fees, a loss halt, per-tick invariants, and a decision journal.
;; The M0 sim tape does not charge *fee-per-unit* and does not halt.
(load "/workspace/aura-market/soft/market/window.aura")

(define *ref-fails* 0)
(define *ref-prev-tick* -1)

(define (mk:journal! action base trial)
  (mk:ledger-note! action base trial)
  (display "AUDIT tick=")
  (display (number->string *tick*))
  (display " action=")
  (display action)
  (display " base=")
  (display (mk:nstr base))
  (display " trial=")
  (display (mk:nstr trial))
  (newline)
  0)

(define (mk:book-ok? bk)
  (cond
    ((null? bk) #t)
    ((or (<= (mk:o-qty (car bk)) 0)
         (<= (mk:o-px (car bk)) 0))
     #f)
    (#t (mk:book-ok? (cdr bk)))))

(define (mk:ref-fail! reason)
  (set! *ref-fails* (+ *ref-fails* 1))
  (display "INVARIANT fail reason=")
  (display reason)
  (display " tick=")
  (display (number->string *tick*))
  (newline)
  0)

(define (mk:ref-check!)
  (let ((bid (mk:side-of *book* 0))
        (ask (mk:side-of *book* 1)))
    (if (> (mk:abs *inv*) *inv-limit*)
        (mk:ref-fail! "inv-limit"))
    (if (not (mk:book-ok? *book*))
        (mk:ref-fail! "book-order"))
    (if (and bid ask (>= (mk:o-px bid) (mk:o-px ask)))
        (mk:ref-fail! "crossed-book"))
    (if (not (= *pnl* (+ *cash* (* *inv* *fair*))))
        (mk:ref-fail! "pnl"))
    (if (not (= *penalty* (+ (quotient *invsum* 4) (* 2 (mk:abs *inv*)))))
        (mk:ref-fail! "penalty"))
    (if (not (= *cash* (- *gross-cash* *fee-paid*)))
        (mk:ref-fail! "cash"))
    (if (< *fee-paid* 0)
        (mk:ref-fail! "fee"))
    (if (<= *tick* *ref-prev-tick*)
        (mk:ref-fail! "tick"))
    (if (and (= *halt* 1) (> (length *book*) 0))
        (mk:ref-fail! "halt-book"))
    (set! *ref-prev-tick* *tick*)
    (if (and (= *halt* 0)
             (number? *loss-floor*)
             (< (mk:live-score) *loss-floor*))
        (mk:halt! "loss-floor"))
    *ref-fails*))

;; New session on the same fee schedule and loss floor.
(define (mk:ref-reset!)
  (mk:reset!)
  (set! *win-deltas* (list))
  (set! *win-prev-pnl* 0)
  (set! *win-prev-pen* 0)
  (set! *win-score* 0)
  (set! *win-phase* "base")
  (set! *win-next* #f)
  (set! *win-body* #f)
  (set! *win-base* #f)
  (set! *ref-prev-tick* -1)
  (set! *ref-fails* 0)
  0)
