;; M4 feature law. Ends with MARKET_M4_OK when every section passes.
(load "/workspace/aura-market/soft/market/book.aura")
(load "/workspace/aura-market/soft/market/book_m12.aura")
(load "/workspace/aura-market/soft/market/features.aura")
(load "/workspace/aura-market/soft/market/rules.aura")
(load "/workspace/aura-market/soft/market/propose.aura")

(define *fail* 0)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (mk:nstr got))
  (if (= got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (mk:nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

;; M4-1. Two-arg path is unchanged. Four-arg path sees drift and imb.
(expect "SCORE_TIGHT" (mk:score quote-tight 1) -5)
(expect "SCORE_WIDE" (mk:score quote-wide 2) 18)
(expect "IMB" (mk:feat-imb 1 -2 3 4) 6)

(define (quote-feat fair inv drift imb)
  (list (- fair 3)
        (+ 5 drift)
        (+ fair 3)
        (+ 5 imb)))

(expect "FEAT_SCORE"
        (mk:r-score
         (mk:sim-go quote-feat 2 "feat" 0 *seed* *ticks* 1))
        32)

(if (= *fail* 0)
    (display "M4_1_OK\n")
    (display "M4_1_FAIL\n"))

;; M4-2. Three or six integers. A short list still fails the probe.
(define (tag? r want)
  (and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) want)))

(if (not (mk:pack-ok? (list 3 5 0)))
    (begin (display "PACK3_FAIL\n") (set! *fail* (+ *fail* 1))))
(if (not (mk:pack-ok? (list 3 5 0 1 -2 4)))
    (begin (display "PACK6_FAIL\n") (set! *fail* (+ *fail* 1))))
(if (mk:pack-ok? (list 3 5))
    (begin (display "PACK_SHORT_FAIL\n") (set! *fail* (+ *fail* 1))))
(if (mk:pack-ok? (list 3 5 0 1 "x" 0))
    (begin (display "PACK_NAN_FAIL\n") (set! *fail* (+ *fail* 1))))
(expect "W_MISS" (mk:pack-winv (list 3 5 0)) 0)
(define seeded (mk:strategy-seed!))
(if (not (and (pair? seeded) (equal? (car seeded) #t)))
    (begin (display "SEED_FAIL\n") (set! *fail* (+ *fail* 1))))
(define ugly (mk:propose-file!
              "/workspace/aura-market/soft/market/fixtures/ugly.lambda"))
(if (not (tag? ugly "propose_heal"))
    (begin (display "UGLY_FAIL\n") (set! *fail* (+ *fail* 1))))

(if (= *fail* 0)
    (display "M4_2_OK\n")
    (display "M4_2_FAIL\n"))

;; M4-3. Zero weights match the three-integer pack. The gate sees orders.
(expect "PACK_WIDE" (mk:score-pack (list 3 5 0)) 18)
(expect "PACK_WIDE6" (mk:score-pack (list 3 5 0 0 0 0)) 18)
(expect "PACK_BETTER" (mk:score-pack (list 3 3 0)) 36)
(expect "PACK_BETTER6" (mk:score-pack (list 3 3 0 0 0 0)) 36)
(expect "WEIGHTED" (mk:score-pack (list 3 5 0 0 1 0)) 35)

(if (= *fail* 0)
    (display "M4_3_OK\n")
    (display "M4_3_FAIL\n"))

;; M4-4. A six-list passes the gate. set! is still rejected.
(define six-drop
  (mk:propose-file!
   "/workspace/aura-market/soft/market/fixtures/six_drop.lambda"))
(if (not (tag? six-drop "propose_drop"))
    (begin (display "SIX_DROP_FAIL\n") (set! *fail* (+ *fail* 1))))
(define bad (mk:propose-file!
             "/workspace/aura-market/soft/market/fixtures/bad.lambda"))
(if (not (tag? bad "propose_reject"))
    (begin (display "BAD_FAIL\n") (set! *fail* (+ *fail* 1))))
(define four (mk:propose-body! "(lambda () (list 3 5 0 1))"))
(if (not (tag? four "propose_heal"))
    (begin (display "FOUR_FAIL\n") (set! *fail* (+ *fail* 1))))
(if (not (equal? (mk:law) (list 3 5 0)))
    (begin (display "LAW_FAIL\n") (set! *fail* (+ *fail* 1))))

(if (= *fail* 0)
    (display "M4_4_OK\n")
    (display "M4_4_FAIL\n"))

;; M4-5. Panel minimum KEEP, and a six-pack that only wins one seed DROP.
(expect "SEED6" (mk:score-pack (list 2 2 2 0 0 0)) 50)
(define seed6
  (mk:propose-file!
   "/workspace/aura-market/soft/market/fixtures/six_seed.lambda"))
(if (not (tag? seed6 "propose_drop"))
    (begin (display "SEED6_DROP_FAIL\n") (set! *fail* (+ *fail* 1))))
(expect "SEED6_TRIAL" *trial-last* -4)
(define keep6
  (mk:propose-file!
   "/workspace/aura-market/soft/market/fixtures/six_keep.lambda"))
(if (not (tag? keep6 "propose_keep"))
    (begin (display "KEEP6_FAIL\n") (set! *fail* (+ *fail* 1))))
(expect "KEEP6_TRIAL" *trial-last* 36)
(if (not (equal? (mk:law) (list 3 3 0 0 0 0)))
    (begin (display "KEEP6_LAW_FAIL\n") (set! *fail* (+ *fail* 1))))

(if (= *fail* 0)
    (display "M4_5_OK\n")
    (display "M4_5_FAIL\n"))

(if (= *fail* 0)
    (display "MARKET_M4_OK\n")
    (display "MARKET_M4_FAIL\n"))
