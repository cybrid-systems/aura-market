;; One live book. Ticks 1-12 are calm. From tick 13, drift is clamped at 0.
;; Heal restores the pre-swap code. It does not rewind fills, cash, or inventory.
;; The frozen wide run is the baseline a trial is measured against.
(load "/workspace/aura-market/soft/market/ref.aura")

(define *body-333* "(lambda () (list 3 3 0 0 0 0))")
(define *body-230* "(lambda () (list 2 3 0 0 0 0))")
(define *body-360* "(lambda () (list 3 6 0))")
(define *body-poison* "(lambda () (list 9 5 0))")

(define *fail* 0)
(define *regime-mode* "calm")
(define *rewind* 0)
(define *prev-tick* -1)
(define *prev-fills* 0)
(define *w12* 0)
(define *w24* 0)
(define *w36* 0)
(define *w48* 0)
(define *frozen-score* 0)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (if (number? got) (mk:nstr got) got))
  (if (equal? got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (if (number? want) (mk:nstr want) want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (expect-pack tag p hs sz ib wv wd wi)
  (display tag)
  (display "=")
  (if (mk:pack-ok? p)
      (begin
        (display (mk:nstr (mk:pack-hs p)))
        (display ",")
        (display (mk:nstr (mk:pack-sz p)))
        (display ",")
        (display (mk:nstr (mk:pack-ib p)))
        (display ",")
        (display (mk:nstr (mk:pack-winv p)))
        (display ",")
        (display (mk:nstr (mk:pack-wdrift p)))
        (display ",")
        (display (mk:nstr (mk:pack-wimb p))))
      (display "bad"))
  (if (and (mk:pack-ok? p)
           (= (mk:pack-hs p) hs)
           (= (mk:pack-sz p) sz)
           (= (mk:pack-ib p) ib)
           (= (mk:pack-winv p) wv)
           (= (mk:pack-wdrift p) wd)
           (= (mk:pack-wimb p) wi))
      (display " OK")
      (begin
        (display " WANT=")
        (display (mk:nstr hs))
        (display ",")
        (display (mk:nstr sz))
        (display ",")
        (display (mk:nstr ib))
        (set! *fail* (+ *fail* 1))))
  (newline)
  p)

(define (mk:restore-wide!)
  (set! *main-body* *wide-body*)
  (hot-strategy:swap! "mk:law" *wide-body* "restore")
  (hot-strategy:swap! "mk:shadow" *wide-body* "restore")
  (hot-strategy:register! "mk:law" *wide-body*)
  (mk:apply-law-params!))

(define (mk:arm-regime!)
  (cond
    ((string=? *regime-mode* "calm")
     (set! *live-regime* "calm"))
    ((< *tick* 12)
     (set! *live-regime* "calm"))
    (#t
     (set! *live-regime* "drift"))))

(define (mk:one!)
  (mk:arm-regime!)
  (mk:live-tick! "mk:law")
  (if (or (<= *tick* *prev-tick*) (< *fills* *prev-fills*))
      (set! *rewind* (+ *rewind* 1)))
  (set! *prev-tick* *tick*)
  (set! *prev-fills* *fills*))

(define (mk:note!)
  (cond
    ((= *tick* 12) (set! *w12* *win-score*))
    ((= *tick* 24) (set! *w24* *win-score*))
    ((= *tick* 36) (set! *w36* *win-score*))
    ((= *tick* 48) (set! *w48* *win-score*))))

(define (mk:run! n)
  (let loop ((i 0))
    (if (< i n)
        (begin
          (mk:one!)
          (if (= (modulo *tick* 12) 0)
              (mk:note!))
          (loop (+ i 1))))))

(define (mk:begin! mode)
  (mk:ref-reset!)
  (mk:restore-wide!)
  (set! *regime-mode* mode)
  (set! *rewind* 0)
  (set! *prev-tick* -1)
  (set! *prev-fills* 0)
  0)

;; Bar is wide's own drift window. KEEP means the trial beat staying wide.
(define (mk:trial! body)
  (mk:begin! "switch")
  (mk:window-base! -1000000)
  (mk:window-arm! body)
  (mk:run! 12)
  (set! *win-base* 7)
  (mk:run! 36))

(mk:strategy-seed!)
(expect "M0_TIGHT" (mk:score quote-tight 1) -5)
(expect "M0_WIDE" (mk:score quote-wide 2) 18)

;; Calm live tape. The regime hook must not move the pinned windows.
(mk:begin! "calm")
(mk:run! 48)
(expect "CALM_W12" *w12* -15)
(expect "CALM_W24" *w24* 1)
(expect "CALM_W36" *w36* 9)
(expect "CALM_W48" *w48* 10)
(expect "CALM_TICK" *tick* 48)
(expect "CALM_FAILS" *ref-fails* 0)
(expect "CALM_REWIND" *rewind* 0)

;; Same book, drift after tick 12, wide never swapped.
(mk:begin! "switch")
(mk:run! 48)
(set! *frozen-score* (mk:live-score))
(expect "FROZEN_W12" *w12* -15)
(expect "FROZEN_W24" *w24* 7)
(expect "FROZEN_W36" *w36* 11)
(expect "FROZEN_W48" *w48* 15)
(expect "FROZEN_SCORE" *frozen-score* 18)
(expect "FROZEN_CASH" *cash* -65)
(expect "FROZEN_FILLS" *fills* 15)
(expect-pack "FROZEN_LAW" (mk:law) 3 5 0 0 0 0)
(expect "FROZEN_FAILS" *ref-fails* 0)
(expect "FROZEN_REWIND" *rewind* 0)

;; Spread 9 cannot be hit. The drift window is the trial. Heal puts wide
;; back. Cash, inventory, and fills at the heal tick are the trial's.
(mk:begin! "switch")
(mk:window-base! -1000000)
(mk:window-arm! *body-poison*)
(mk:run! 12)
(define *stuck-inv* *inv*)
(define *stuck-cash* *cash*)
(define *stuck-fills* *fills*)
(expect "POISON_ON" (mk:pack-hs (mk:law)) 9)
(expect-pack "POISON_SHADOW" (mk:shadow) 3 5 0 0 0 0)
(set! *win-base* 7)
(mk:run! 12)
(expect "POISON_WIN" *w24* -20)
(expect "POISON_STUCK_INV" *inv* *stuck-inv*)
(expect "POISON_STUCK_CASH" *cash* *stuck-cash*)
(expect "POISON_STUCK_FILLS" *fills* *stuck-fills*)
(expect "POISON_INV" *inv* -5)
(expect "POISON_CASH" *cash* 514)
(expect "POISON_FILLS" *fills* 3)
(expect-pack "POISON_HEAL_LAW" (mk:law) 3 5 0 0 0 0)
(expect-pack "POISON_HEAL_SHADOW" (mk:shadow) 3 5 0 0 0 0)
(expect "POISON_HEAL_TICK" *tick* 24)
(mk:run! 24)
(expect "POISON_SCORE" (mk:live-score) -21)
(expect "POISON_GAP" (- (mk:live-score) *frozen-score*) -39)
(expect "POISON_END_FILLS" *fills* 9)
(expect-pack "POISON_END_LAW" (mk:law) 3 5 0 0 0 0)
(expect-pack "POISON_END_SHADOW" (mk:shadow) 3 5 0 0 0 0)
(expect "POISON_TICK" *tick* 48)
(expect "POISON_FAILS" *ref-fails* 0)
(expect "POISON_REWIND" *rewind* 0)

;; Same prices as wide, size 6. Taker qty is at most 4, so the trial ties.
;; Tie heals. The rest of the tape matches the frozen book.
(mk:trial! *body-360*)
(expect "TIE_WIN" *w24* 7)
(expect "TIE_SCORE" (mk:live-score) *frozen-score*)
(expect "TIE_CASH" *cash* -65)
(expect "TIE_FILLS" *fills* 15)
(expect-pack "TIE_LAW" (mk:law) 3 5 0 0 0 0)
(expect-pack "TIE_SHADOW" (mk:shadow) 3 5 0 0 0 0)
(expect "TIE_FAILS" *ref-fails* 0)
(expect "TIE_REWIND" *rewind* 0)

;; (2 3 0) loses the drift window and heals. The leftover inventory
;; is not the frozen inventory, so the end gap is not the window gap.
(mk:trial! *body-230*)
(expect "LEAN_WIN" *w24* -1)
(expect "LEAN_SCORE" (mk:live-score) 20)
(expect "LEAN_GAP" (- (mk:live-score) *frozen-score*) 2)
(expect-pack "LEAN_LAW" (mk:law) 3 5 0 0 0 0)
(expect-pack "LEAN_SHADOW" (mk:shadow) 3 5 0 0 0 0)
(expect "LEAN_TICK" *tick* 48)
(expect "LEAN_FAILS" *ref-fails* 0)
(expect "LEAN_REWIND" *rewind* 0)

;; Shipped rule: the bar is the calm window (-15), not wide's drift window.
;; Trial 4 beats -15, so the pack is kept, even though 4 < 7.
(mk:begin! "switch")
(mk:window-base! -1000000)
(mk:window-arm! *body-333*)
(mk:run! 48)
(expect "KEEP_W12" *w12* -15)
(expect "KEEP_WIN" *w24* 4)
(expect "KEEP_BASE" *win-base* 4)
(expect "KEEP_SCORE" (mk:live-score) 22)
(expect "KEEP_GAP" (- (mk:live-score) *frozen-score*) 4)
(expect-pack "KEEP_LAW" (mk:law) 3 3 0 0 0 0)
(expect-pack "KEEP_SHADOW" (mk:shadow) 3 3 0 0 0 0)
(expect "KEEP_FAILS" *ref-fails* 0)
(expect "KEEP_REWIND" *rewind* 0)

;; Calm champion installed up front. Nothing heals it when the flow changes.
(mk:begin! "switch")
(mk:apply-body! *body-333* "install")
(mk:run! 48)
(expect "STALE_SCORE" (mk:live-score) 13)
(expect "STALE_GAP" (- (mk:live-score) *frozen-score*) -5)
(expect-pack "STALE_LAW" (mk:law) 3 3 0 0 0 0)
(expect-pack "STALE_SHADOW" (mk:shadow) 3 5 0 0 0 0)
(expect "STALE_TICK" *tick* 48)
(expect "STALE_FAILS" *ref-fails* 0)
(expect "STALE_REWIND" *rewind* 0)

(if (= *fail* 0)
    (display "MARKET_VALUE_OK\n")
    (display "MARKET_VALUE_FAIL\n"))
